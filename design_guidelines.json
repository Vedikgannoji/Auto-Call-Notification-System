  "instructions_to_main_agent": [
    "Install 'lucide-react' for icons if not present.",
    "Use 'recharts' for the attendance analytics chart.",
    "Implement the Dashboard with a Sidebar layout using 'Outlet' from react-router-dom.",
    "Ensure the Login page uses the provided hero image as a split-screen or full-background with overlay.",
    "Use 'Sonner' for all toast notifications (success/error).",
    "Strictly follow the 'Bento Grid' layout for the dashboard home.",
    "For the Student List, use a dense table with pagination and bulk actions (checkboxes).",
    "Add 'data-testid' to all buttons, inputs, and links."
  ],
  "universal_guidelines": [
    "Do not use gradients for text.",
    "Avoid centering text in long paragraphs.",
    "Use 'p-6' or 'p-8' padding for cards to allow breathing room.",
    "Use skeleton loaders for data fetching states.",
    "Ensure mobile responsiveness: Stack the sidebar into a drawer/sheet on mobile."
  ]
}